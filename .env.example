# Auth.js (optional while auth is paused — app runs open/guest)
AUTH_SECRET=            # generate with: openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional local credentials provider (unused while app is open)
AUTH_DEV_BYPASS=false
AUTH_DEV_EMAIL=dev@bits-pilani.ac.in
AUTH_DEV_NAME=GradPath Dev

# Database (Neon Postgres)
DATABASE_URL=

# AI (OpenRouter)
OPENROUTER_API_KEY=
# Fast free defaults (set these on Vercel too)
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_FALLBACK_MODEL=openrouter/free

OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=GradPath

# Rate limiting
DAILY_LIMIT=5

# Access control
BITS_ALLOWED_DOMAINS=bits-pilani.ac.in
